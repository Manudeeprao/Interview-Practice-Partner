# Copy this file to .env and fill in your values
# Get your free Groq API key at: https://console.groq.com

GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Optional: Groq model used for all LLM calls (default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: sentence-transformers embedding model (default: all-MiniLM-L6-v2)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: Flask configuration
FLASK_ENV=development
FLASK_PORT=5000

# Optional: comma-separated CORS origins (React dev server defaults included)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: local storage locations
# SESSION_DB_PATH=backend/data/sessions.sqlite
# CHROMA_DB_DIR=backend/chroma_db
# LANGGRAPH_CHECKPOINT_DB=backend/data/checkpoints.sqlite

# Optional: session + rate-limit tuning
# MAX_SESSIONS=100
# RATE_LIMIT_CHAT_PER_MIN=30
# RATE_LIMIT_UPLOAD_PER_MIN=10

# Optional: RAG tuning
# RAG_MAX_DISTANCE=0.6   # cosine distance; lower = stricter relevance filter
# DEBUG_RAG=1            # log retrieved chunks per turn
